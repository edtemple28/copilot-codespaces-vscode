<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Resources for Math and Computer Science students by Mr. Temple">
    <meta name="keywords" content="Math, Computer Science, STEM, Education, Lessons, Resources">
    <meta name="author" content="Mr. Temple">
    <title>Mr. Temple's Math and Computer Science Website</title>
    <link rel="stylesheet" href="styles.css">
    <style>
      body {
        background-color: white;
        color: black;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        transition: background-color 0.3s, color 0.3s;
        background-image: url('assets/student-lifting-mathcsintegration.png');
        background-size: cover;
        background-position: center;
      }
      body.dark-mode {
        background-color: maroon;
        color: black;
      }
      .centered-img {
        display: block;
        margin: 20px auto;
        max-width: 90%;
        height: auto;
      }
      header .logo {
        text-align: center;
      }
      nav {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 10px;
        background-color: #007bff;
        position: relative;
      }
      nav ul {
        list-style-type: none;
        padding: 0;
        margin: 0;
        display: flex;
      }
      nav li {
        margin: 0 10px;
      }
      nav a {
        text-decoration: none;
        color: white;
        font-size: 16px;
        padding: 8px 16px;
      }
      nav a:hover {
        background-color: #0056b3;
        border-radius: 5px;
      }
      .menu-toggle {
        display: none;
        background: none;
        border: none;
        color: white;
        font-size: 20px;
        cursor: pointer;
      }
      @media (max-width: 768px) {
        nav ul {
          display: none;
          flex-direction: column;
          width: 100%;
          background-color: #007bff;
          position: absolute;
          top: 50px;
          left: 0;
          text-align: center;
        }
        nav ul.active {
          display: flex;
        }
        .menu-toggle {
          display: block;
        }
      }
      #theme-toggle {
        position: fixed;
        top: 10px;
        right: 10px;
        padding: 10px;
        color: white;
        border: none;
        cursor: pointer;
        border-radius: 5px;
        animation: blink 1s infinite alternate;
      }
      @keyframes blink {
        0% { background-color: #007bff; }
        100% { background-color: #ff0000; }
      }
      .counter {
        text-align: center;
        margin: 20px;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        background-color: #f9f9f9;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">
        <h1>Mr. Temple's Math & CS Website</h1>
      </div>
    </header>
    <nav>
      <button class="menu-toggle">&#9776;</button>
      <ul>
        <li><a href="index.html">Home</a></li>
        <li><a href="https://www.linkedin.com/in/ed-temple-8076726b/" target="_blank">About Mr. Temple</a></li>
        <li><a href="https://www.youtube.com/playlist?list=PLU2SDYwAHXMwEQptmfmhUomvNqqf93G9p" target="_blank">Computer Science</a></li>
        <li><a href="https://youtu.be/D50pnV1bjU8?si=485-L21WM9wfQSLl" target="_blank">STEM</a></li>
        <li><a href="mailto:coachedtemple@gmail.com">Contact</a></li>
        <li><a href="https://theedtemple.blogspot.com" target="_blank">Blog</a></li>
      </ul>
    </nav>
    <button id="theme-toggle">Switch Theme</button>
    <main>
      <section class="intro">
        <h2>Welcome to My Website!</h2>
        <p>Providing resources for Math and Computer Science students.</p>
        <img src="assets/bar-graph.gif" class="centered-img" alt="Bar Graph Animation">
      </section>
      <section class="counter">
        <h3>Website Visit Counter</h3>
        <p>Daily Visits: <span id="daily-count">0</span></p>
        <p>Monthly Visits: <span id="monthly-count">0</span></p>
        <p>Total Visits: <span id="total-count">0</span></p>
      </section>
    </main>
  </body>
</html>
